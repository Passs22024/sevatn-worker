API_BASE_URL=https://api.sevatn.online
MACHINE_CODE=PC-AWS-001
MACHINE_NAME=AWS Demo Worker
# Leave MACHINE_TOKEN empty on first boot to initiate pairing workflow via Admin Dashboard
MACHINE_TOKEN=
# Path to persistent credentials storage file (mount via Docker volume)
CREDENTIALS_PATH=/app/credentials/.worker-credentials.json
VERSION=1.0.0
HEADLESS=true
CHECK_INTERVAL_MS=15000
HEARTBEAT_INTERVAL_MS=10000
# Execution controls: Set MAX_ACTIVE_BOOKINGS=0 for safe standby (monitoring only until Super Admin authorizes)
MAX_ACTIVE_BOOKINGS=0
MAX_AVAILABILITY_MONITORS=2
# Must match central API master key (minimum 16 characters)
CREDENTIAL_ENCRYPTION_KEY=replace_with_secure_random_key_min_32_chars


