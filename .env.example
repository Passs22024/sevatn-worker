API_BASE_URL=https://api.your-domain.com
MACHINE_CODE=PC-RAILWAY-001
MACHINE_NAME=Railway Demo Worker
# Leave MACHINE_TOKEN empty on first boot to initiate pairing workflow via Admin Dashboard
MACHINE_TOKEN=
VERSION=1.0.0
HEADLESS=true
CHECK_INTERVAL_MS=15000
HEARTBEAT_INTERVAL_MS=10000
# Execution controls: Set MAX_ACTIVE_BOOKINGS=1 for Railway demo worker (or >= 1 to claim and execute bookings). Set to 0 for passive monitoring only.
MAX_ACTIVE_BOOKINGS=1
MAX_AVAILABILITY_MONITORS=2
# Must match central API master key (minimum 16 characters)
CREDENTIAL_ENCRYPTION_KEY=replace_with_secure_random_key_min_32_chars

